# Copy this file to .env and fill in real values.
# .env is in .gitignore — never commit it.

# --- LLM (OpenAI-compatible) ---
# Azure OpenAI v1 API: your endpoint + /openai/v1/  (no api-version needed)
LLM_BASE_URL=https://<your-resource-name>.openai.azure.com/openai/v1/
LLM_API_KEY=
# On Azure this is your DEPLOYMENT name, not the model name
LLM_CHAT_MODEL=gpt-5-mini

# --- Database (matches docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_dev_password

# --- Embeddings (runs locally, first run downloads ~2.3 GB) ---
EMBEDDING_MODEL=BAAI/bge-m3
# local = real model · hash = offline test stub (not semantic)
EMBEDDING_BACKEND=local

# --- RAG tuning ---
# Skip the LLM when the best match is weaker than this — calibrated for bge-m3 in docs/eval/gate.md
RAG_MIN_SIMILARITY=0.5
RAG_MIN_BM25=4.5

# --- LLM cost guards / estimates ---
LLM_MAX_COMPLETION_TOKENS=2000
# gpt-5 family: minimal | low | medium | high (lower = faster, cheaper)
LLM_REASONING_EFFORT=low
# USD per 1M tokens — check the Azure OpenAI pricing page for your deployment
LLM_PRICE_INPUT_PER_1M=0.25
LLM_PRICE_OUTPUT_PER_1M=2.00
USD_THB=33

# --- Mock HRIS (NawaHR) API — week 1 ---
HRIS_URL=http://localhost:8001
HRIS_API_KEY=dev-hris-key-change-me
# Pin "today" for demos/tests (leave empty to use the real date)
HRIS_TODAY=

# --- Sign-in (week 5) ---
# Password given to the demo personas by scripts/load_seed.py (fictional company, demo only)
DEMO_PASSWORD=nawa-demo-2026
# Show the demo account list on the login page (set 0 for a "real" looking login)
DEMO_MODE=1
# Sign out after this many idle minutes
SESSION_IDLE_MINUTES=30

# --- Tracing with Langfuse (week 6, optional) ---
# Free account: https://cloud.langfuse.com  -> Settings -> API keys. Leave empty to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# 1 = send prompts/answers (masked) to Langfuse; 0 = only tokens, cost, latency, agents
LANGFUSE_CAPTURE_CONTENT=1
